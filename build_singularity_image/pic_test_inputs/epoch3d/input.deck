begin:control
  nx = 6
  ny = 6
  nz = 6
  t_end = 1 * femto
  x_min = 0
  x_max = 1 * micron
  y_min = 0
  y_max = 1 * micron
  z_min = 0
  z_max = 1 * micron
  stdout_frequency = 1
end:control

begin:boundaries
  bc_x_min = open
  bc_x_max = open
  bc_y_min = periodic
  bc_y_max = periodic
  bc_z_min = periodic
  bc_z_max = periodic
end:boundaries

begin:output
  dt_snapshot = 1 * femto
  grid = always
  ey = always
end:output
