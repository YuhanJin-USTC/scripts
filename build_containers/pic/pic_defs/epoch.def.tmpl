Bootstrap: localimage
From: {{ENV_IMAGE}}

%files

    {{TAR_NAME}} {{TAR_TARGET}}

%post

    EPOCH_COMPILER="{{EPOCH_COMPILER}}"
    # The SDF submake also reads MPIF90 from the environment.
    export I_MPI_ROOT="{{MPI_ROOT}}"
    export MPIF90="$I_MPI_ROOT/bin/mpif90"
    export LD_LIBRARY_PATH="$I_MPI_ROOT/lib/release:$I_MPI_ROOT/lib:$I_MPI_ROOT/libfabric/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

    BUILD_DIR="{{BUILD_DIR}}"
    mkdir -p $BUILD_DIR
    cd $BUILD_DIR

    tar -zxvf {{TAR_TARGET}} --strip-components 1
    rm {{TAR_TARGET}}

    cd {{EPOCH_DIM}}

    echo "Cleaning up old build files..."
    make COMPILER=$EPOCH_COMPILER clean

    echo "Starting compilation..."
    make COMPILER=$EPOCH_COMPILER -j{{JOBS}}

    cd ..
    rm -rf {{CLEAN_ITEMS}}

%environment

    export PATH={{BUILD_DIR}}/{{EPOCH_DIM}}/bin:$PATH

%runscript

    exec {{EXEC_NAME}} "$@"
