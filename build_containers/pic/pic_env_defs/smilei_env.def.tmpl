Bootstrap: docker
From: {{DOCKER_IMAGE}}

%post

    export DEBIAN_FRONTEND=noninteractive
    export TZ=Asia/Shanghai
    echo "tzdata tzdata/Areas select Asia" >timezone.txt
    echo "tzdata tzdata/Zones/Asia select Shanghai" >>timezone.txt
    debconf-set-selections timezone.txt
    echo "Asia/Shanghai" >/etc/timezone
    rm -f timezone.txt

    apt-get update && apt-get install -y ca-certificates gnupg wget
    wget -qO- https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB \
        | gpg --batch --dearmor -o /usr/share/keyrings/oneapi-archive-keyring.gpg
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/oneapi-archive-keyring.gpg] https://apt.repos.intel.com/oneapi all main" >/etc/apt/sources.list.d/oneapi.list
    apt-get update && apt-get install -y {{APT_PACKAGES}}

    export I_MPI_ROOT="{{MPI_ROOT}}"
    export PATH="$I_MPI_ROOT/bin:$PATH"
    export LD_LIBRARY_PATH="$I_MPI_ROOT/lib/release:$I_MPI_ROOT/lib:$I_MPI_ROOT/libfabric/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

    pip install --no-cache-dir numpy scipy -i {{PIP_INDEX}}

    mkdir -p {{HDF5_SOURCE_DIR}}
    cd {{HDF5_SOURCE_DIR}}
    wget https://github.com/HDFGroup/hdf5/releases/download/hdf5_{{HDF5_VERSION}}/hdf5-{{HDF5_VERSION}}.tar.gz
    tar -zxvf hdf5-{{HDF5_VERSION}}.tar.gz
    rm hdf5-{{HDF5_VERSION}}.tar.gz

    cd hdf5-{{HDF5_VERSION}}
    ./configure --prefix={{HDF5_PREFIX}} --enable-parallel \
      --with-pic --enable-shared --enable-build-mode=production \
      --disable-sharedlib-rpath --enable-static CC="$I_MPI_ROOT/bin/mpicc" FC="$I_MPI_ROOT/bin/mpif90"
    make -j {{JOBS}}
    make install

    cd {{HDF5_SOURCE_DIR}}
    CODEX_TEMP_CLEANUP=1 rm -rf "hdf5-{{HDF5_VERSION}}"

    # Remove standalone MPI debug symbols.
    CODEX_TEMP_CLEANUP=1 rm -f \
        "{{MPI_ROOT}}/lib/release/libmpi.dbg" \
        "{{MPI_ROOT}}/lib/release_mt/libmpi.dbg" \
        "{{MPI_ROOT}}/lib/debug/libmpi.dbg" \
        "{{MPI_ROOT}}/lib/debug_mt/libmpi.dbg"

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment

    export I_MPI_ROOT="{{MPI_ROOT}}"
    export PATH="$I_MPI_ROOT/bin:$PATH"
    export LD_LIBRARY_PATH="$I_MPI_ROOT/lib/release:$I_MPI_ROOT/lib:$I_MPI_ROOT/libfabric/lib:{{HDF5_PREFIX}}/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export FI_PROVIDER_PATH="${FI_PROVIDER_PATH:-$I_MPI_ROOT/libfabric/lib/prov}"

%runscript
